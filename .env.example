# Use ./scripts/install.sh to generate this file with random credentials.
# Copy this example only when configuring a deployment manually.
WEB_BIND_IP=127.0.0.1
WEB_PORT=3001
POSTGRES_PORT=5433
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
# Общий максимум потоков дубликатов и контаминаций; ограничивается доступными CPU.
GENOTYPE_SEARCH_WORKERS=4

# Optional DNAEXCEL network: create dna_integration before enabling this override.
# COMPOSE_FILE=docker-compose.yml:docker-compose.integration.yml

# Enable only after staged migration 037 and an agreed cutover (see docs/LEGACY_EXPORT_AND_REIMPORT.md).
UNIFIED_WORKSPACE_ENABLED=false
